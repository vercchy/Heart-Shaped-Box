{
  "name": "@hsb/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations and the shared database client.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc",
    "dev": "prisma generate && tsc --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio"
  },
  "devDependencies": {
    "@hsb/eslint-config": "workspace:*",
    "@hsb/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1"
  }
}
